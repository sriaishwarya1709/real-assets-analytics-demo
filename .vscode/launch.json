{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portfolio Lens (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}\\src\\PortfolioLens\\bin\\Debug\\net10.0\\PortfolioLens.dll",
      "cwd": "${workspaceFolder}\\src\\PortfolioLens",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://localhost:5180" },
      "serverReadyAction": { "action": "openExternally", "pattern": "\\bNow listening on:\\s+(https?://\\S+)" }
    }
  ]
}
